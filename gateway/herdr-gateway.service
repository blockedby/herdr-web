[Unit]
Description=Authenticated Herdr Telegram gateway
After=docker.service network-online.target
Requires=docker.service

[Service]
Restart=on-failure
RestartSec=5
ExecStart=/usr/bin/docker run --rm --name herdr-telegram-gateway --network host --read-only --cap-drop ALL --security-opt no-new-privileges --pids-limit 128 --memory 256m --cpus 1 --env-file /opt/herdr-gateway/.env herdr-telegram-gateway:local
ExecStop=/usr/bin/docker stop herdr-telegram-gateway
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
